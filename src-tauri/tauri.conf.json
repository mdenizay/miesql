{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MieSQL",
  "version": "1.0.0",
  "identifier": "com.mdenizay.miesql",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MieSQL",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A fast, native SQL client",
    "longDescription": "An open-source alternative to Navicat for PostgreSQL, MySQL, MariaDB, SQLite, Redis and MongoDB. All data stays on your device.",
    "copyright": "MIT licensed. https://github.com/mdenizay/miesql",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mdenizay/miesql/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRTRDQTRCRTEzRTIxNTgKUldSWUlUN2hTOHJrM0dnMnJBQkhFNFQvK3k4UDVPSGNMaGFEQ05DYUhnK0pteUtZY3dETklKbTYK"
    }
  }
}
